# Local browser origin. Use your canonical HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Clerk handles email/password, verification, recovery and Google sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Supabase is used for PostgreSQL and private image storage.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only Supabase secret/service-role key for private Storage.
SUPABASE_SECRET_KEY=
# Supabase transaction pooler URI; URL-encode password characters. Server only.
DATABASE_URL=
